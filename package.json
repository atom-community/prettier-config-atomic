{
  "name": "prettier-config-atomic",
  "version": "4.1.0",
  "description": "The Prettier configuration used in atom-community",
  "keywords": [
    "prettier",
    "prettier-config",
    "prettier-preset",
    "format",
    "beautify"
  ],
  "repository": "https://github.com/atom-community/prettier-config-atomic",
  "license": "MIT",
  "author": "Amin Yahyaabadi",
  "type": "module",
  "main": "dist/prettier.config.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --pretty",
    "bump": "ncu -u",
    "format": "prettier --write ./ --config ./prettier.config.js",
    "lint": "eslint . --fix",
    "prepare": "pnpm run build",
    "test.format": "prettier ./ --check",
    "test.lint": "eslint ."
  },
  "dependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "sort-package-json": "^4.0.0"
  },
  "devDependencies": {
    "@tsconfig/bases": "^1.0.28",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-atomic": "^2.3.0",
    "globify-gitignore": "^1.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.3.1"
}
